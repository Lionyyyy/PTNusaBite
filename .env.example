# Salin menjadi ".env" untuk menjalankan di komputer sendiri. Jangan commit file .env.
PORT=3000

# Pilihan A — MySQL lokal
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nusabite
DB_PASSWORD=nusabite
DB_NAME=nusabite

# Pilihan B — MySQL cloud (Aiven). Bila DATABASE_URL diisi, DB_HOST dkk. diabaikan.
# DATABASE_URL=mysql://avnadmin:PASSWORD@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# DB_SSL=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

SESSION_SECRET=ganti-dengan-teks-acak-panjang
DEMO_PASSWORD=demo1234
ALLOW_RESET=true
